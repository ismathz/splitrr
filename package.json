{
  "name": "splitbot",
  "private": true,
  "overrides": {
    "better-sqlite3": "workspace:packages/better-sqlite3-stub"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "dev:bot": "bun run --cwd apps/bot dev",
    "dev:miniapp": "bun run --cwd apps/miniapp dev",
    "test": "bun test",
    "lint": "bunx tsc -b --pretty --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0"
  }
}
