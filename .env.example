NODE_ENV=development
PORT=3000
BOT_PORT=3001
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=http://localhost:5173
# Deep links for /split in groups + announce reopen URL (no @).
# Short name must match BotFather Mini App; default `app` if unset in bot/api.
TELEGRAM_BOT_USERNAME=SplitrrBot
TELEGRAM_MINI_APP_SHORT_NAME=app
# Local Mini App / curl without Telegram initData.
# MUST be unset/false when NODE_ENV=production (API refuses to start otherwise).
SPLITBOT_DEV_AUTH_BYPASS=true
# Cron auth for POST /api/reminders/run (header X-Cron-Secret)
REMINDER_CRON_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SQLITE_PATH=./data/splitbot.db
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=receipts/dev
# Cloudflare R2 example:
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=splitbot-receipts
# S3_ACCESS_KEY_ID=<r2_access_key_id>
# S3_SECRET_ACCESS_KEY=<r2_secret_access_key>
# S3_KEY_PREFIX=receipts/prod
BACKUP_BUCKET=
BACKUP_PREFIX=backups/splitbot/dev
