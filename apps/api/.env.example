# Copy to repo root `.env` or `apps/api/.env` (both are loaded; api wins on conflicts).

NODE_ENV=development
PORT=3000
SQLITE_PATH=./data/splitbot.db

# OpenRouter (preferred). Remove any legacy OPENAI_API_KEY from the VPS .env.
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# S3-compatible storage (e.g. MinIO, R2, AWS S3). S3_ENDPOINT must be a full URL.
S3_BUCKET=your-bucket
S3_ENDPOINT=https://example.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=receipts

# Required for Mini App auth (unless SPLITBOT_DEV_AUTH_BYPASS=true)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=http://localhost:5173
# Announce deep links (defaults match @SplitrrBot / short name `app`)
TELEGRAM_BOT_USERNAME=SplitrrBot
TELEGRAM_MINI_APP_SHORT_NAME=app
# Local only — API refuses to start if this is true when NODE_ENV=production
SPLITBOT_DEV_AUTH_BYPASS=true
REMINDER_CRON_SECRET=

# Optional backup target (used by scripts/nightly-backup.sh)
# BACKUP_BUCKET=
# BACKUP_PREFIX=backups/splitbot/dev
