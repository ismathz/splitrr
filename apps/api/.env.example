# Copy to repo root `.env` or `apps/api/.env` (both are loaded; api wins on conflicts).

NODE_ENV=development
PORT=3000
SQLITE_PATH=./data/splitbot.db

OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4.1-mini

# S3-compatible storage (e.g. MinIO, R2, AWS S3). S3_ENDPOINT must be a full URL.
S3_BUCKET=your-bucket
S3_ENDPOINT=https://example.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=receipts

# Optional
# TELEGRAM_BOT_TOKEN=
# BACKUP_BUCKET=
# BACKUP_PREFIX=backups/splitbot/dev
