# Base URL of the Splitrr API (bills + OCR). Required for production builds.
# VITE_SPLITBOT_API=https://api.example.com

# Base URL of the Splitrr bot (same host as webhook) for POST /miniapp/group-members
# VITE_BOT_MINIAPP_API=http://localhost:3001

# Log Telegram.WebApp init snapshot to the console once per load
# VITE_TELEGRAM_DEBUG_INIT=true

# Local-only: fixture bills/members + in-memory mock for all Mini App API calls
# (create/upload/OCR/save/history/roster/payment/announce). No API or bot needed.
# Requires Vite DEV. Never set for production builds.
# VITE_SPLITBOT_USE_MOCK_DATA=true

# Optional mock latency (ms) so upload/scan UI states are easy to polish.
# VITE_SPLITBOT_MOCK_UPLOAD_MS=1200
# VITE_SPLITBOT_MOCK_OCR_MS=2000
# VITE_SPLITBOT_MOCK_CREATE_MS=350
# VITE_SPLITBOT_MOCK_SAVE_MS=400

# Local-only (DEV): force a telegram chat id when not launched from Telegram.
# VITE_DEV_TELEGRAM_CHAT_ID=-1001234567890

# Local-only (DEV + VITE_SPLITBOT_USE_MOCK_DATA): comma-separated member names.
# VITE_TELEGRAM_GROUP_MEMBERS=Alice,Bob,Carol
