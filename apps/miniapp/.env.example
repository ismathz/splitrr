# Base URL of the Splitbot API (bills + OCR). Required for production builds.
# VITE_SPLITBOT_API=https://api.example.com

# Base URL of the Splitbot bot (same host as webhook) for POST /miniapp/group-members
# VITE_BOT_MINIAPP_API=http://localhost:3001

# Log Telegram.WebApp init snapshot to the console once per load
# VITE_TELEGRAM_DEBUG_INIT=true

# Local-only: show fixture bills/members when the API/Telegram context is missing.
# Requires Vite DEV. Never set for production builds.
# VITE_SPLITBOT_USE_MOCK_DATA=true

# Local-only (DEV): force a telegram chat id when not launched from Telegram.
# VITE_DEV_TELEGRAM_CHAT_ID=-1001234567890

# Local-only (DEV + VITE_SPLITBOT_USE_MOCK_DATA): comma-separated member names.
# VITE_TELEGRAM_GROUP_MEMBERS=Alice,Bob,Carol
